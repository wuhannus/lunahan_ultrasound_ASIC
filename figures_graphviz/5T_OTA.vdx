<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<VisioDocument xmlns="http://schemas.microsoft.com/visio/2003/core">
  <DocumentProperties>
    <Title>5-Transistor OTA</Title>
    <Creator>Han Wu</Creator>
  </DocumentProperties>
  < Masters>
    <Master ID="2" Name="PMOS">
      <Shapes>
        <Shape ID="3" Type="Shape" Name="PMOS">
          <XForm><Width>1</Width><Height>1.5</Height></XForm>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo>
            <LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.4</Y></LineTo>
            <LineTo><X>0.1</X><Y>1.4</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
          <Char IX="0"><Font>2</Font><Size>0.25</Size></Char>
          <Para IX="0"><HorAlign>1</HorAlign></Para>
        </Shape>
      </Shapes>
    </Master>
    <Master ID="4" Name="NMOS">
      <Shapes>
        <Shape ID="5" Type="Shape" Name="NMOS">
          <XForm><Width>1</Width><Height>1.5</Height></XForm>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo>
            <LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.4</Y></LineTo>
            <LineTo><X>0.1</X><Y>1.4</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
          <Fill>
            <FillForegnd>#EEEEEE</FillForegnd>
            <FillBkgnd>#EEEEEE</FillBkgnd>
            <FillPattern>1</FillPattern>
          </Fill>
        </Shape>
      </Shapes>
    </Master>
    <Master ID="6" Name="Wire">
      <Shapes>
        <Shape ID="7" Type="Shape" Name="Wire">
          <XForm><Width>0</Width><Height>0</Height></XForm>
          <Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0</X><Y>0</Y></MoveTo>
            <LineTo><X>1</X><Y>1</Y></LineTo>
          </Geom>
        </Shape>
      </Shapes>
    </Master>
  </Masters>
  <Pages>
    <Page ID="0" Name="5T-OTA">
      <PageSheet><PageProps><PageWidth>11</PageWidth><PageHeight>8.5</PageHeight><PageScale>1</PageScale><DrawingScale>1</DrawingScale></PageProps></PageSheet>
      <Shapes>
        <!-- Title -->
        <Shape ID="100" Type="Shape" Name="Title">
          <XForm><PinX>5.5</PinX><PinY>0.5</PinY><Width>5</Width><Height>0.6</Height></XForm>
          <Text><cp IX="0">5-Transistor OTA Schematic</cp></Text>
          <Char IX="0"><Size>0.4</Size><Color>#1A1A1A</Color><Style>17</Style></Char>
          <Para IX="0"><HorAlign>1</HorAlign></Para>
          <Fill><FillForegnd>#E8F0FE</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.02</LineWeight><LineColor>#2D5AA0</LineColor></Line>
        </Shape>

        <!-- VDD Label -->
        <Shape ID="200" Type="Shape" Name="VDD">
          <XForm><PinX>8</PinX><PinY>1.0</PinY><Width>1</Width><Height>0.4</Height></XForm>
          <Text><cp IX="0">VDD</cp></Text>
          <Char IX="0"><Size>0.3</Size><Color>#CC0000</Color><Style>17</Style></Char>
        </Shape>

        <!-- M1 PMOS -->
        <Shape ID="301" Type="Shape" Name="M1 body">
          <XForm><PinX>3</PinX><PinY>3</PinY><Width>1</Width><Height>1.4</Height></XForm>
          <Fill><FillForegnd>#FFFFFF</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.03</LineWeight></Line>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo><LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.3</Y></LineTo><LineTo><X>0.1</X><Y>1.3</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
        </Shape>
        <Shape ID="302" Type="Shape" Name="M1 label">
          <XForm><PinX>3.5</PinX><PinY>3.9</PinY><Width>0.6</Width><Height>0.3</Height></XForm>
          <Text><cp IX="0">M1</cp></Text>
          <Char IX="0"><Size>0.28</Size><Style>17</Style></Char>
        </Shape>

        <!-- M2 PMOS -->
        <Shape ID="401" Type="Shape" Name="M2 body">
          <XForm><PinX>7</PinX><PinY>3</PinY><Width>1</Width><Height>1.4</Height></XForm>
          <Fill><FillForegnd>#FFFFFF</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.03</LineWeight></Line>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo><LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.3</Y></LineTo><LineTo><X>0.1</X><Y>1.3</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
        </Shape>
        <Shape ID="402" Type="Shape" Name="M2 label">
          <XForm><PinX>7.5</PinX><PinY>3.9</PinY><Width>0.6</Width><Height>0.3</Height></XForm>
          <Text><cp IX="0">M2</cp></Text>
          <Char IX="0"><Size>0.28</Size><Style>17</Style></Char>
        </Shape>

        <!-- M3 NMOS -->
        <Shape ID="501" Type="Shape" Name="M3 body">
          <XForm><PinX>3</PinX><PinY>5.5</PinY><Width>1</Width><Height>1.4</Height></XForm>
          <Fill><FillForegnd>#EEEEEE</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.03</LineWeight></Line>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo><LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.3</Y></LineTo><LineTo><X>0.1</X><Y>1.3</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
        </Shape>
        <Shape ID="502" Type="Shape" Name="M3 label">
          <XForm><PinX>3.5</PinX><PinY>6.4</PinY><Width>0.6</Width><Height>0.3</Height></XForm>
          <Text><cp IX="0">M3</cp></Text>
          <Char IX="0"><Size>0.28</Size><Style>17</Style></Char>
        </Shape>

        <!-- M4 NMOS -->
        <Shape ID="601" Type="Shape" Name="M4 body">
          <XForm><PinX>7</PinX><PinY>5.5</PinY><Width>1</Width><Height>1.4</Height></XForm>
          <Fill><FillForegnd>#EEEEEE</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.03</LineWeight></Line>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo><LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.3</Y></LineTo><LineTo><X>0.1</X><Y>1.3</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
        </Shape>
        <Shape ID="602" Type="Shape" Name="M4 label">
          <XForm><PinX>7.5</PinX><PinY>6.4</PinY><Width>0.6</Width><Height>0.3</Height></XForm>
          <Text><cp IX="0">M4</cp></Text>
          <Char IX="0"><Size>0.28</Size><Style>17</Style></Char>
        </Shape>

        <!-- M5 NMOS -->
        <Shape ID="701" Type="Shape" Name="M5 body">
          <XForm><PinX>5</PinX><PinY>7.2</PinY><Width>1</Width><Height>1.4</Height></XForm>
          <Fill><FillForegnd>#EEEEEE</FillForegnd><FillPattern>1</FillPattern></Fill>
          <Line><LineWeight>0.03</LineWeight></Line>
          <Geom IX="0"><NoFill>0</NoFill><NoLine>0</NoLine>
            <MoveTo><X>0.1</X><Y>0.1</Y></MoveTo><LineTo><X>0.9</X><Y>0.1</Y></LineTo>
            <LineTo><X>0.9</X><Y>1.3</Y></LineTo><LineTo><X>0.1</X><Y>1.3</Y></LineTo>
            <LineTo><X>0.1</X><Y>0.1</Y></LineTo>
          </Geom>
        </Shape>
        <Shape ID="702" Type="Shape" Name="M5 label">
          <XForm><PinX>5.5</PinX><PinY>8.1</PinY><Width>0.6</Width><Height>0.3</Height></XForm>
          <Text><cp IX="0">M5</cp></Text>
          <Char IX="0"><Size>0.28</Size><Style>17</Style></Char>
        </Shape>

        <!-- Labels -->
        <Shape ID="800" Type="Shape"><XForm><PinX>2.2</PinX><PinY>2.8</PinY><Width>1</Width><Height>0.3</Height></XForm><Text><cp IX="0">Vin-</cp></Text><Char IX="0"><Size>0.28</Size><Style>17</Style></Char></Shape>
        <Shape ID="801" Type="Shape"><XForm><PinX>8</PinX><PinY>2.8</PinY><Width>1</Width><Height>0.3</Height></XForm><Text><cp IX="0">Vin+</cp></Text><Char IX="0"><Size>0.28</Size><Style>17</Style></Char></Shape>
        <Shape ID="802" Type="Shape"><XForm><PinX>8</PinX><PinY>4.2</PinY><Width>1</Width><Height>0.3</Height></XForm><Text><cp IX="0">Vout</cp></Text><Char IX="0"><Size>0.28</Size><Color>#CC0000</Color><Style>17</Style></Char></Shape>
        <Shape ID="803" Type="Shape"><XForm><PinX>3.5</PinX><PinY>7</PinY><Width>1</Width><Height>0.3</Height></XForm><Text><cp IX="0">Vbias</cp></Text><Char IX="0"><Size>0.28</Size><Style>17</Style></Char></Shape>
        <Shape ID="804" Type="Shape"><XForm><PinX>5</PinX><PinY>2.3</PinY><Width>2</Width><Height>0.3</Height></XForm><Text><cp IX="0">(Diff Pair)</cp></Text><Char IX="0"><Size>0.2</Size><Color>#888888</Color></Char></Shape>
        <Shape ID="805" Type="Shape"><XForm><PinX>1</PinX><PinY>4.8</PinY><Width>2</Width><Height>0.3</Height></XForm><Text><cp IX="0">(Load Mirror)</cp></Text><Char IX="0"><Size>0.2</Size><Color>#888888</Color></Char></Shape>
        <Shape ID="806" Type="Shape"><XForm><PinX>1</PinX><PinY>6.9</PinY><Width>2</Width><Height>0.3</Height></XForm><Text><cp IX="0">(Tail Current)</cp></Text><Char IX="0"><Size>0.2</Size><Color>#888888</Color></Char></Shape>

        <!-- GND -->
        <Shape ID="900" Type="Shape"><XForm><PinX>5.5</PinX><PinY>8.6</PinY><Width>1</Width><Height>0.3</Height></XForm><Text><cp IX="0">GND</cp></Text><Char IX="0"><Size>0.28</Size><Style>17</Style></Char></Shape>

        <!-- WIRES (connector lines) -->
        <!-- VDD rail -->
        <Shape ID="1000" Type="Shape"><XForm><PinX>5.5</PinX><PinY>1.5</PinY><Width>8</Width><Height>0</Height></XForm><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>0</X><Y>0</Y></MoveTo><LineTo><X>8</X><Y>0</Y></LineTo></Geom><Line><LineWeight>0.04</LineWeight><LineColor>#CC0000</LineColor></Line></Shape>
        <!-- VDD to M1 source -->
        <Shape ID="1001" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>3</X><Y>1.5</Y></MoveTo><LineTo><X>3</X><Y>2.3</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- VDD to M2 source -->
        <Shape ID="1002" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7</X><Y>1.5</Y></MoveTo><LineTo><X>7</X><Y>2.3</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M1 gate -->
        <Shape ID="1003" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>2.3</X><Y>3</Y></MoveTo><LineTo><X>2.5</X><Y>3</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M2 gate -->
        <Shape ID="1004" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7.5</X><Y>3</Y></MoveTo><LineTo><X>8</X><Y>3</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M1 drain to M3 -->
        <Shape ID="1005" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>3</X><Y>3.7</Y></MoveTo><LineTo><X>3</X><Y>4.8</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M2 drain to M4 -->
        <Shape ID="1006" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7</X><Y>3.7</Y></MoveTo><LineTo><X>7</X><Y>4.8</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- Vout wire -->
        <Shape ID="1007" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7</X><Y>4</Y></MoveTo><LineTo><X>8</X><Y>4</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight><LineColor>#CC0000</LineColor></Line></Shape>
        <!-- Cross wire between drains -->
        <Shape ID="1008" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>3</X><Y>3.7</Y></MoveTo><LineTo><X>5</X><Y>3.7</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <Shape ID="1009" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7</X><Y>3.7</Y></MoveTo><LineTo><X>5</X><Y>3.7</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <Shape ID="1010" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>5</X><Y>3.7</Y></MoveTo><LineTo><X>5</X><Y>6.5</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M3 gate-drain diode -->
        <Shape ID="1011" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>2</X><Y>5.5</Y></MoveTo><LineTo><X>3</X><Y>5.5</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight><LineColor>#006600</LineColor></Line></Shape>
        <Shape ID="1012" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>2</X><Y>4.8</Y></MoveTo><LineTo><X>2</X><Y>5.5</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight><LineColor>#006600</LineColor></Line></Shape>
        <!-- M3 gate to M4 gate -->
        <Shape ID="1013" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>2</X><Y>5.5</Y></MoveTo><LineTo><X>7</X><Y>5.5</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight><LineColor>#006600</LineColor></Line></Shape>
        <!-- M4 gate lead -->
        <Shape ID="1014" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>7</X><Y>4.8</Y></MoveTo><LineTo><X>7</X><Y>5.5</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight><LineColor>#006600</LineColor></Line></Shape>
        <!-- M5 gate -->
        <Shape ID="1015" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>3.5</X><Y>7.2</Y></MoveTo><LineTo><X>4.5</X><Y>7.2</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- M5 source to GND -->
        <Shape ID="1016" Type="Shape"><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>5</X><Y>7.9</Y></MoveTo><LineTo><X>5</X><Y>8.3</Y></LineTo></Geom><Line><LineWeight>0.03</LineWeight></Line></Shape>
        <!-- GND rail -->
        <Shape ID="1017" Type="Shape"><XForm><PinX>5.5</PinX><PinY>8.3</PinY><Width>3</Width><Height>0</Height></XForm><Geom IX="0"><NoFill>1</NoFill><NoLine>0</NoLine><MoveTo><X>0</X><Y>0</Y></MoveTo><LineTo><X>3</X><Y>0</Y></LineTo></Geom><Line><LineWeight>0.05</LineWeight></Line></Shape>
      </Shapes>
    </Page>
  </Pages>
</VisioDocument>