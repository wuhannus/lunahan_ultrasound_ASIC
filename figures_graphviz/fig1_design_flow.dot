// Figure 1: Open-Source Mixed-Signal ASIC Design Flow
// Graphviz DOT — auto-layout, no overlaps, consistent fonts

digraph design_flow {
    rankdir=LR;
    dpi=200;
    fontname="Helvetica";
    fontsize=22;
    bgcolor=white;
    label="Open-Source Mixed-Signal ASIC Design Flow";
    labelloc=t;
    fontsize=28;
    labeljust=c;

    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=16, penwidth=3];
    edge [fontname="Helvetica", fontsize=13, penwidth=3, arrowsize=1.2];

    // Phase nodes
    phase1 [label="Phase 1\nSystem Specification\n\n• Range, fps, channels\n• Link budget analysis\n• BAG spec cascade", fillcolor="#dce8fc", color="#1446a0"];
    phase2 [label="Phase 2\nSchematic & Pre-Layout Sim\n\n• LNA, ADC, UERTX\n• PMU, PLL design\n• Xyce SPICE, 5 corners", fillcolor="#dce8fc", color="#1446a0"];
    phase3 [label="Phase 3\nDigital RTL & Verification\n\n• RISC-V RV32IMC core\n• TX/RX/PMU controllers\n• PV-RXBF, Verilator sim", fillcolor="#fde8d0", color="#dc7814"];
    phase4 [label="Phase 4\nLayout & DRC/LVS\n\n• Parameterized placement\n• Yosys+OpenROAD P&R\n• Magic DRC, Netgen LVS", fillcolor="#d8f0d8", color="#1e8c1e"];
    phase5 [label="Phase 5\nPost-Layout PEX Simulation\n\n• Parasitic extraction\n• Re-sim with parasitics\n• Degradation check", fillcolor="#e8d8f8", color="#8232c8"];
    phase6 [label="Phase 6\nSystem Verification\n\n• 6 scenarios co-simulation\n• Xyce+Verilator bridge\n• vs JSSC 2022 specs", fillcolor="#f8d8d8", color="#c82828"];

    // Forward flow
    phase1 -> phase2 [color="#1446a0", label="Forward flow", fontcolor="#1446a0"];
    phase2 -> phase3 [color="#1446a0"];
    phase3 -> phase4 [color="#1446a0"];
    phase4 -> phase5 [color="#1446a0"];
    phase5 -> phase6 [color="#1446a0"];

    // Feedback loop
    phase6 -> phase1 [color="#c82828", style=dashed, label="Loop back\nif fails", fontcolor="#c82828", constraint=false];

    // Legend
    { rank=sink;
      legend [shape=plaintext, label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="4">
        <tr><td bgcolor="#dce8fc"><font point-size="12">  Blue  </font></td><td><font point-size="12">Analog design phases</font></td></tr>
        <tr><td bgcolor="#fde8d0"><font point-size="12">  Orange  </font></td><td><font point-size="12">Digital design phases</font></td></tr>
        <tr><td bgcolor="#d8f0d8"><font point-size="12">  Green  </font></td><td><font point-size="12">Layout and verification</font></td></tr>
        <tr><td bgcolor="#e8d8f8"><font point-size="12">  Purple  </font></td><td><font point-size="12">Post-layout analysis</font></td></tr>
        <tr><td bgcolor="#f8d8d8"><font point-size="12">  Red  </font></td><td><font point-size="12">System verification</font></td></tr>
        <tr><td><font point-size="12">  Dashed Red  </font></td><td><font point-size="12">Feedback loop (BAG loop-engineering)</font></td></tr>
        </table>
      >];
    }

    // Tools bar
    tools [shape=box, style=filled, fillcolor="#f0f0f0", color=gray, label="Tools: Xyce [15] | Yosys [16] | OpenROAD [14] | Magic | Netgen | Verilator | sky130 PDK [13] | Python BAG [3]", fontsize=13];
}
