digraph G {
    dpi=250;
    fontname="Helvetica";
    bgcolor=white;
    size="7.5,5.625";
    ratio=fill;
    pad=0.05;
    nodesep=0.15;
    ranksep=0.2;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.5, margin="0.06,0.04"];
    edge [fontname="Helvetica", fontsize=8, penwidth=1.5, arrowsize=0.8, color="#333333"];

    rankdir=TB;
    label="Ultrasound ASIC System Architecture (sky130 PDK)";
    labelloc=t; fontsize=11;
    node [fillcolor=white, color="#333333"];
    afe [label="ANALOG FRONT-END\nRX(x64): LNA(40dB,2.5NF) to SAR ADC(10b,9.6ENOB,1.2MS/s) | TX: UERTX H-Bridge+CSTORE (44.2pct saving) [1] | PMU: Boost(6-14V)+LDOx2(1.8V,78pct eff)", width=4.0, fillcolor="#e8f0ff"];
    digital [label="DIGITAL CONTROLLER\nRISC-V RV32IMC: 5-stage,48MHz,18.2mW, I/D-Cache 4KB | Periph: TX Ctrl,RX Ctrl,PMU Ctrl\nPV-RXBF [2]: 64ch delay-sum beamformer, 32x32 grid, 24fps, approx 10 MFP/s", width=4.0, fillcolor="#fff0e0"];
    clock [label="CLOCK + I/O\nPLL: 16MHz to 50MHz(sys)+1.2MHz(ADC), Lock 28.4us, Jitter 38.2ps RMS, Power 2.0mW\nExt: AXI4-Lite, UART 115200, SPI, GPIO 16b | Transducers: 4x4 arrays x4 directions", width=4.0, fillcolor="#f0ffe0"];
    afe -> digital [color="#2255aa", penwidth=2, label="ADC data"];
    digital -> clock [color="#2255aa", penwidth=2, label="Control"];
    clock -> afe [color="#2255aa", style=dashed, penwidth=1.5, label="Clock dist"];

}
