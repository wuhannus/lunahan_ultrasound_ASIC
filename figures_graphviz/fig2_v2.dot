digraph G {
    dpi=250;
    fontname="Helvetica";
    bgcolor=white;
    size="7.5,5.625";
    ratio=compress;
    pad=0.2;
    nodesep=0.5;
    ranksep=0.6;
    pack="true";
    packmode="node";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, penwidth=1.5, margin="0.08,0.06"];
    edge [fontname="Helvetica", fontsize=7, penwidth=1.5, arrowsize=0.8, color="#333333"];

    rankdir=TB;
    label="Ultrasound ASIC System Architecture (sky130 PDK)";
    labelloc=t; fontsize=11; fontname="Helvetica";
    
    subgraph cluster_afe {
        label="ANALOG FRONT-END"; fontsize=9;
        style="rounded,dashed"; color="#2255aa"; penwidth=1.5;
        node [fillcolor=white, color="#333333"];
        rx [label="RX Chain (x64 channels)\nLNA(30dB)\u2192VGA(0-46dB)\u2192BPF\u2192SAR ADC(10b,9.6ENOB)", width=2.8];
        txpmu [label="TX Driver + PMU\nUERTX: H-Bridge+CSTORE, 44.2% saving\nPMU: Boost(6-14V)+LDOx2(1.8V), 78% eff.", width=2.8];
        rx -> txpmu [style=invis];
    }
    
    subgraph cluster_digital {
        label="DIGITAL CONTROLLER"; fontsize=9;
        style="rounded,dashed"; color="#2255aa"; penwidth=1.5;
        node [fillcolor=white, color="#333333"];
        core [label="RISC-V RV32IMC Core\n5-stage pipeline, 48MHz, 18.2mW\nI-Cache 4KB, D-Cache 4KB", width=2.8];
        periph [label="Peripherals\nTX Controller | RX Controller | PMU Controller\nPV-RXBF: 64ch Delay-and-Sum, 32x32, 24fps", width=2.8];
    }

    subgraph cluster_clock {
        label="CLOCK"; fontsize=9;
        style="rounded,dashed"; color="#2255aa"; penwidth=1.5;
        node [fillcolor=white, color="#333333"];
        pll [label="Charge-Pump PLL (sky130)\n16MHz\u219250MHz(sys)+1.2MHz(ADC)\nLock:28.4us, Jitter:38.2ps RMS, Power:2.0mW", width=2.8];
    }

    subgraph cluster_io {
        label="EXTERNAL INTERFACES"; fontsize=9;
        style="rounded,dashed"; color="#2255aa"; penwidth=1.5;
        node [fillcolor=white, color="#333333"];
        io [label="AXI4-Lite Bus | UART 115200 | SPI Mode 0\nGPIO 16-bit | 4x4 Transducer Arrays x4 Directions", width=2.8];
    }
    
    rx -> core [color="#2255aa", style=dashed, label="ADC data stream"];
    pll -> core [color="#2255aa", label="50MHz"];

}
