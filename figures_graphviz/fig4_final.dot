digraph G {
    dpi=250;
    fontname="Helvetica";
    bgcolor=white;
    size="7.5,5.625";
    ratio=fill;
    pad=0.05;
    nodesep=0.15;
    ranksep=0.2;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, penwidth=1.5, margin="0.06,0.04"];
    edge [fontname="Helvetica", fontsize=8, penwidth=1.5, arrowsize=0.8, color="#333333"];

    rankdir=LR;
    label="PV-RXBF Beamformer Hardware Pipeline [2]";
    labelloc=t; fontsize=11;
    node [fillcolor=white, color="#333333"];
    adc [label="ADC Samples\n64ch x 10b\nfs=1.2 MS/s", width=1.2];
    delay [label="64-Channel\nDelay Lines\n4096x10b SRAM", width=1.3];
    apod [label="Apodization\nHanning Window\n64 x 8b ROM", width=1.3];
    mac [label="Multiply-Accumulate\n64-stage pipeline\n16-bit sum", width=1.4];
    out [label="Output\n16-bit\nper voxel", width=1.1];
    adc -> delay -> apod -> mac -> out [color="#2255aa", penwidth=2];
    subgraph cluster_sram {
        label="SRAM Blocks"; fontsize=9; style="rounded,dashed"; color="#888888"; penwidth=1;
        node [fillcolor="#f5f5f5", color="#333333"];
        dtbl [label="Delay Table\n96 KB\n65536x12b", width=1.2];
        sbuf [label="Sample Buffer\n320 KB\n64x4096x10b", width=1.2];
        seq [label="Voxel Sequencer\n32x32 Raster", width=1.2];
        perf [shape=plaintext, label=<
            <table border="1" cellborder="1" cellspacing="0" cellpadding="3">
            <tr><td bgcolor="#e8e8e8"><font point-size="9">Throughput</font></td><td><font point-size="9">approx 10 MFP/s</font></td></tr>
            <tr><td bgcolor="#e8e8e8"><font point-size="9">Latency</font></td><td><font point-size="9">approx 8 us/voxel</font></td></tr>
            <tr><td bgcolor="#e8e8e8"><font point-size="9">Frame Rate</font></td><td><font point-size="9">24 fps</font></td></tr>
            </table>
        >];
        dtbl->delay [color="#888888", style=dashed, constraint=false];
        sbuf->delay [color="#888888", style=dashed, constraint=false];
        seq->out [color="#888888", style=dashed, constraint=false];
    }

}
