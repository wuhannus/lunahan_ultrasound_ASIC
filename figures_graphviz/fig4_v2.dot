digraph G {
    dpi=250;
    fontname="Helvetica";
    bgcolor=white;
    size="7.5,5.625";
    ratio=compress;
    pad=0.2;
    nodesep=0.5;
    ranksep=0.6;
    pack="true";
    packmode="node";
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, penwidth=1.5, margin="0.08,0.06"];
    edge [fontname="Helvetica", fontsize=7, penwidth=1.5, arrowsize=0.8, color="#333333"];

    rankdir=LR;
    label="PV-RXBF Beamformer Hardware Pipeline [2]";
    labelloc=t; fontsize=11; fontname="Helvetica";
    node [fillcolor=white, color="#333333"];
    
    subgraph cluster_pipe {
        label="(a) Pipeline"; fontsize=9;
        style="rounded"; color="#333333"; penwidth=1.2;
        adc [label="ADC\nSamples\n64ch", width=1.1];
        delay [label="Delay\nLines\n64x4096", width=1.2];
        apod [label="Apodize\nHanning\n64x8b", width=1.1];
        mac [label="Multiply-\nAccumulate\n64-stage", width=1.3];
        out [label="Output\n16-bit", width=1.0];
        adc -> delay -> apod -> mac -> out [color="#2255aa"];
    }
    
    subgraph cluster_sram {
        label="(b) SRAM Blocks"; fontsize=9;
        style="rounded"; color="#333333"; penwidth=1.2;
        node [fillcolor="#f5f5f5", color="#333333"];
        dtbl [label="Delay Table\n96 KB\n32x32x64", width=1.4];
        sbuf [label="Sample Buffer\n320 KB\n64x4096", width=1.4];
        seq [label="Voxel Sequencer\n32x32 raster\nx,y coord gen", width=1.4];
        dtbl -> delay [color="#888888", style=dashed, dir=both];
        sbuf -> delay [color="#888888", style=dashed];
        seq -> out [color="#888888", style=dashed];
    }
    
    subgraph cluster_perf {
        label="(c) Performance"; fontsize=9;
        style="rounded"; color="#333333"; penwidth=1.2;
        metrics [shape=plaintext, label=<
            <table border="1" cellborder="1" cellspacing="0" cellpadding="4">
            <tr><td bgcolor="#e8e8e8"><font point-size="9"><b>Metric</b></font></td><td bgcolor="#e8e8e8"><font point-size="9"><b>Value</b></font></td></tr>
            <tr><td><font point-size="9">Throughput</font></td><td><font point-size="9">~10 MFP/s</font></td></tr>
            <tr><td><font point-size="9">Latency/voxel</font></td><td><font point-size="9">~8 us</font></td></tr>
            <tr><td><font point-size="9">Frame Rate</font></td><td><font point-size="9">24 fps</font></td></tr>
            <tr><td><font point-size="9">Voxel Grid</font></td><td><font point-size="9">32 x 32 = 1024</font></td></tr>
            <tr><td><font point-size="9">Channels</font></td><td><font point-size="9">64 (8x8 array)</font></td></tr>
            </table>
        >];
    }

}
